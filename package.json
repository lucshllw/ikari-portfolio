    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
