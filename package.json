    "@fontsource-variable/syne": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@sveltejs/adapter-node": "5.5.7",
    "better-auth": "1.7.7",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
